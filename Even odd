#include <stdio.h>

void main()
{
    int i;

    for(i = 0; i <= 10; i++)
    {
        if(i == 0)
        {
            printf("%d is zero\n", i);
        }
        else if(i % 2 == 0)
        {
            printf("%d is even\n", i);
        }
        else
        {
            printf("%d is odd\n", i);
        }
    }
}
